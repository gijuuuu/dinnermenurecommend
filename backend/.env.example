# 추천 모드: mock(기본값, 결제 없이 고정 메뉴 랜덤 추천) | openai(실제 OpenAI API 호출)
RECOMMEND_MODE=mock

# ↓ RECOMMEND_MODE=openai 로 바꿀 때만 필요합니다.
# OpenAI API 키 (https://platform.openai.com/api-keys 에서 발급)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 사용할 모델 (기본값: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# 서버 포트 (기본값: 3000)
PORT=3000

# 프론트엔드 CORS 허용 origin (여러 개면 콤마로 구분, 기본값: *)
CORS_ORIGIN=*
